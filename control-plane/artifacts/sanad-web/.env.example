# sanad-web (control plane) — environment.
#
# Local dev: copy this to `.env` (git-ignored) and fill in real values.
# Production: set these as Railway *service variables* — never baked into the
# image. The only value needed at build time is the publishable Clerk key.

# --- Clerk (auth / org tenants / enterprise SSO) ---
# CLERK_PUBLISHABLE_KEY is also needed at BUILD time: next.config inlines it into
# the browser bundle as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY. It is publishable, so
# it is passed to the image as a build arg (not a secret).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...            # Clerk webhook endpoint -> /api/webhooks/clerk

# --- Postgres (Railway-managed) ---
# On Railway, reference the Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Stripe (billing) ---
# Previously supplied by the Replit Stripe integration; now plain env vars.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # Stripe webhook endpoint -> /api/webhooks/stripe
STRIPE_PRO_PRICE_ID=price_...             # created by scripts/seed-stripe-products.ts
STRIPE_TEAM_PRICE_ID=price_...

# --- URLs ---
APP_URL=https://sanadcode.com                       # public URL of this service
GATEWAY_BASE_URL=https://gateway.sanadcode.com/v1   # the Foundry gateway (service B)
